  "heldoutQuran": [
    {
      "ref": "2:71",
      "reciter": "Alafasy_128kbps",
      "transcript": "17. قال إنه يقول إنها بقرة الله لون تسيه الأرض ولا تسف الحرث مسلمة لا شي تفيها 17. قال الآن جئتب الحق فذبحها وما كادوا يفعلون",
      "refTokens": 24
    },
    {
      "ref": "2:226",
      "reciter": "Alafasy_128kbps",
      "transcript": "للذين يقلون من نساءهم تربص أربعة أشهر فإن فاء فإن الله غفر وحيم",
      "refTokens": 13
    },
    {
      "ref": "3:95",
      "reciter": "Alafasy_128kbps",
      "transcript": "14. قل صدق الله فتبعوا من لتأبرعه محنيف وما كان من المشركين",
      "refTokens": 11
    },
    {
      "ref": "4:50",
      "reciter": "Alafasy_128kbps",
      "transcript": "أوظر كيف يفترون على الله الكذب وكفابه إسمم مبينة",
      "refTokens": 10
    },
    {
      "ref": "5:29",
      "reciter": "Alafasy_128kbps",
      "transcript": "إني أريد أن تبور أبي إثمي وإثمك فتكون من أصحاب نار وذلك جزاء الظالمين",
      "refTokens": 13
    },
    {
      "ref": "6:64",
      "reciter": "Alafasy_128kbps",
      "transcript": "قل الله ينجيكم منها ومن كل كر بناس ما أنتم تشركون",
      "refTokens": 10
    },
    {
      "ref": "7:54",
      "reciter": "Alafasy_128kbps",
      "transcript": "25. إن ربكم الله الذي خلق السماوات والأرض في ستة آيام ثم استواء على العرش 30. ثم استواء على العرش يوش ليلنهار يقول به حثيثا و الشمسة والقمر وان نجوم مسخرات بأمره 30. آلهم الخلق والأمر تبارك الله رب العالمين",
      "refTokens": 32
    },
    {
      "ref": "8:3",
      "reciter": "Alafasy_128kbps",
      "transcript": "الذين يقيمون الصلاة ومنما رزقنا هم ينفقون",
      "refTokens": 6
    },
    {
      "ref": "9:83",
      "reciter": "Alafasy_128kbps",
      "transcript": "25. فإررجعك الله إلى طائفة منهم فستأذنك للخروج فقل لن تخرجوا فقل لن تخرجوا معي أبدا ولا تقاتل معي عدوه 25. إنكم رضيت بالقعود أول مرة فقعدوا مع الخالفين",
      "refTokens": 25
    },
    {
      "ref": "10:109",
      "reciter": "Alafasy_128kbps",
      "transcript": "والتبعما يوحى إليك وصبر حتى يحكم الله وهو خير الحاكنين",
      "refTokens": 11
    },
    {
      "ref": "12:32",
      "reciter": "Alafasy_128kbps",
      "transcript": "قالت فذلك الن الذين تننيفه ولقد راوته عن نفسه فستعصم ولإن لم يفعل ما أمره لا يسجنًا ولا يكون من الصغرين",
      "refTokens": 19
    },
    {
      "ref": "14:33",
      "reciter": "Alafasy_128kbps",
      "transcript": "و سخفر لكم الشمس والخمر دائبين و سخفر لكم الليل والنهاب",
      "refTokens": 9
    },
    {
      "ref": "16:37",
      "reciter": "Alafasy_128kbps",
      "transcript": "إن تحرص على هداهم فإن الله لا يهدي ما يضل ومالهم من ناصرين",
      "refTokens": 14
    },
    {
      "ref": "17:64",
      "reciter": "Alafasy_128kbps",
      "transcript": "وستفزز من استطعت منهم بصوتك وأجل بعليهم بخيلك ورجلك وشارككم وشارككم في الأموال والأولاد وعدهم وما يعدهم الشيطان إلا وراء",
      "refTokens": 19
    },
    {
      "ref": "18:108",
      "reciter": "Alafasy_128kbps",
      "transcript": "خالدين فيها لا يبقون عنها حولا",
      "refTokens": 6
    },
    {
      "ref": "20:55",
      "reciter": "Alafasy_128kbps",
      "transcript": "منها خلقناكم وفيها نعيدكم ومنها نخرجكم ومنها نخرجكم تارة أخرى",
      "refTokens": 8
    },
    {
      "ref": "21:75",
      "reciter": "Alafasy_128kbps",
      "transcript": "وأدخناه في رحمةنا إنه من الصالحين",
      "refTokens": 6
    },
    {
      "ref": "23:40",
      "reciter": "Alafasy_128kbps",
      "transcript": "قال عنما قليل لا يسبحنا نادمين",
      "refTokens": 5
    },
    {
      "ref": "25:13",
      "reciter": "Alafasy_128kbps",
      "transcript": "وإذا ألطوا منها مكان ضيقا مقرنين دعوهنا لك سبورة",
      "refTokens": 9
    },
    {
      "ref": "26:91",
      "reciter": "Alafasy_128kbps",
      "transcript": "وبرزة الجحيم للغاوم",
      "refTokens": 3
    },
    {
      "ref": "27:19",
      "reciter": "Alafasy_128kbps",
      "transcript": "29. فتبس مضاهك من قولها وقال رب اوزعني وقال رب اوزعني أن أشكر نعمتك التي أن عمت علي وعلى ووليدي وأن أعمل صالحان ترضاه وأدخلني وأدخني برحمة كفي عبادك الصالحين",
      "refTokens": 24
    },
    {
      "ref": "28:81",
      "reciter": "Alafasy_128kbps",
      "transcript": "فخسفنا به وبداره الأرض فما كان له من فأتي يصرونه من دون الله وما كان من المنتصري",
      "refTokens": 17
    },
    {
      "ref": "31:19",
      "reciter": "Alafasy_128kbps",
      "transcript": "وقصد في مشيك ورضب من صوتك إن أنكر الأصوات لصوت الحمير",
      "refTokens": 11
    },
    {
      "ref": "34:37",
      "reciter": "Alafasy_128kbps",
      "transcript": "25. وما أموالكم ولا أولادكم بالتي تقدربكم عندنا زلفاء الله 25. إلا من آمن وعمل صالحا فأولائك لهم جزاء أبعف بما عملوا فأولائك لهم جزاء أبعف بما عملوا وهم في الغرفات آمنون",
      "refTokens": 23
    },
    {
      "ref": "37:10",
      "reciter": "Alafasy_128kbps",
      "transcript": "إلا من خطف الخطفة فأتبعه شهاب ساقب",
      "refTokens": 7
    },
    {
      "ref": "37:165",
      "reciter": "Alafasy_128kbps",
      "transcript": "وإننا لنحن صافهم",
      "refTokens": 3
    },
    {
      "ref": "39:50",
      "reciter": "Alafasy_128kbps",
      "transcript": "قد قال هل الذين من قبلهم فما أرما عنهم ما كانوا يكسبون",
      "refTokens": 11
    },
    {
      "ref": "41:45",
      "reciter": "Alafasy_128kbps",
      "transcript": "12. ولقد آتين موصل كتاب فخط لففيه 12. ولولا كلمة سبقت من ربك لقض يبينهم 12. وإنهم لفي شك منهم ريب",
      "refTokens": 18
    },
    {
      "ref": "44:4",
      "reciter": "Alafasy_128kbps",
      "transcript": "فيها يفوق كل أمر حكيم",
      "refTokens": 5
    },
    {
      "ref": "47:28",
      "reciter": "Alafasy_128kbps",
      "transcript": "5. ذلك بأنه متبعما أسخط الله وكره رضوانه فأحبة أعمالهم",
      "refTokens": 10
    },
    {
      "ref": "51:53",
      "reciter": "Alafasy_128kbps",
      "transcript": "أتوى صوبه بلهم قوموا طعوم",
      "refTokens": 6
    },
    {
      "ref": "54:37",
      "reciter": "Alafasy_128kbps",
      "transcript": "1. ولقد راوته عن ضيفه فطمسنا أعيناهم فلوقوا عذابي ونذر",
      "refTokens": 9
    },
    {
      "ref": "56:59",
      "reciter": "Alafasy_128kbps",
